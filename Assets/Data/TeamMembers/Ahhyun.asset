  m_Name: Ahhyun
  m_EditorClassIdentifier: 
  id: Ahhyun
  displayName: "\uC815\uC544\uD604"
  description: "\uC815\uC544\uD604\uC740 \u201C\uB0A8\uCC9C\uBD09\uB9C8(\u5357\u5929\u5C01\u9B54)\u201D
    \uAC00\uBB38\uC758 \uB9C8\uC9C0\uB9C9 \uD6C4\uC608\uB85C,\n\uBD09\uC778\uC220\uACFC
    \uC815\uD654\uC220\uC744 \uB3D9\uC2DC\uC5D0 \uACC4\uC2B9\uD55C \uC774\uB2A5 \uBD09\uB9C8\uC0AC\uB2E4.\n\n\uADF8\uB140\uC758
    \uBD80\uC801\uC740 \uB2E8\uC21C\uD55C \uC885\uC774 \uC870\uAC01\uC774 \uC544\uB2C8\uB77C,\n\uD63C\uACFC
    \uC778\uC744 \uAE43\uB4E0 \u2018\uBD09\uC778\uB839(\u5C01\u5370\u9748)\u2019
    \u2014\n\uC870\uC0C1 \uB300\uB300\uB85C \uB0B4\uB824\uC628 \uD63C\uC758 \uC870\uAC01\uC73C\uB85C
    \uB9CC\uB4E4\uC5B4\uC9C4 \uAC83\uC774\uB2E4.\n\n\uC5B4\uB9B4 \uC801 \uBD09\uB9C8
    \uC758\uC2DD\uC744 \uAC10\uB2F9\uD558\uC9C0 \uBABB\uD574\n\uB9C8\uC744 \uD558\uB098\uB97C
    \uC815\uD654 \uBD88\uAE38\uB85C \uD0DC\uC6CC\uBC84\uB9B0 \uC0AC\uACE0 \uC774\uD6C4,\n\uC544\uD604\uC740
    \u201C\uC815\uD654\uB294 \uAD6C\uC6D0\uC774\uC790 \uC8C4\u201D\uB77C\uB294 \uC2E0\uB150\uC744
    \uD488\uACE0\n\uD1F4\uB9C8\uC0AC\uB85C\uC11C\uC758 \uAE38\uC744 \uC120\uD0DD\uD588\uB2E4.\n\n\U0001F525\uBD09\uC778\uC9C4\uD3ED
    \u2014 \uC815\uD654\uC758 \uBD88\uAF43\uC744 \uD488\uC740 \uBD80\uC801\uC744
    \uB358\uC838 \uC545\uADC0\uB97C \uBD88\uD0DC\uC6C0\n\n\U0001F300 \uC815\uD654\uC9C4 
    \u2014 \uB9DE\uC740 \uC801\uC744 \uC911\uC2EC\uC73C\uB85C \uACB0\uACC4\uB97C
    \uD3BC\uCCD0 \uC801\uC758 \uC6C0\uC9C1\uC784\uC744 \uC81C\uD55C\uD568"
  rarity: 1
